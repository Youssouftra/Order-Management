@model List<Commande>
@{
    ViewData["Title"] = "Mes Commandes";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <a href="/" class="btn btn-link text-orange mb-3">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            <h2 class="text-orange">Mes Commandes</h2>
            <p class="text-muted">Suivez vos commandes en cours et passees</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-receipt fa-5x text-muted mb-4"></i>
            <h3>Aucune commande</h3>
            <p class="text-muted">Vous n'avez pas encore passe de commande</p>
            <a href="/" class="btn btn-orange">Commander maintenant</a>
        </div>
    }
    else
    {
        <div class="orders-list">
            @foreach (var commande in Model)
            {
                <div class="order-card">
                    <div class="order-header">
                        <div>
                            <span class="order-number">Commande #@commande.Id</span>
                            <span class="order-date">@commande.DateCommande.ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                        <span class="order-status @GetStatusClass(commande.Etat)">@GetStatusText(commande.Etat)</span>
                    </div>
                    <div class="order-body">
                        <div class="order-items">
                            @foreach (var item in commande.Items.Take(3))
                            {
                                <div class="order-item-preview">
                                    @if (!string.IsNullOrEmpty(item.ImageItem))
                                    {
                                        <img src="@item.ImageItem" alt="@item.NomItem">
                                    }
                                    else
                                    {
                                        <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=50" alt="@item.NomItem">
                                    }
                                </div>
                            }
                            @if (commande.Items.Count > 3)
                            {
                                <div class="order-item-more">+@(commande.Items.Count - 3)</div>
                            }
                        </div>
                        <div class="order-info">
                            <div class="order-type">
                                <i class="@GetTypeIcon(commande.TypeCommande)"></i>
                                @GetTypeText(commande.TypeCommande)
                            </div>
                            <div class="order-total">@commande.Total.ToString("N0") FCFA</div>
                        </div>
                    </div>
                    <div class="order-footer">
                        <a asp-action="Detail" asp-route-id="@commande.Id" class="btn btn-sm btn-outline-orange">
                            <i class="fas fa-eye"></i> Details
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    string GetStatusClass(string etat) {
        return etat switch {
            "EN_COURS" => "status-pending",
            "VALIDE" => "status-validated",
            "TERMINE" => "status-completed",
            "ANNULE" => "status-cancelled",
            _ => ""
        };
    }

    string GetStatusText(string etat) {
        return etat switch {
            "EN_COURS" => "En cours",
            "VALIDE" => "Validee",
            "TERMINE" => "Terminee",
            "ANNULE" => "Annulee",
            _ => etat
        };
    }

    string GetTypeIcon(string type) {
        return type switch {
            "SUR_PLACE" => "fas fa-utensils",
            "A_EMPORTER" => "fas fa-shopping-bag",
            "LIVRAISON" => "fas fa-motorcycle",
            _ => "fas fa-receipt"
        };
    }

    string GetTypeText(string type) {
        return type switch {
            "SUR_PLACE" => "Sur place",
            "A_EMPORTER" => "A emporter",
            "LIVRAISON" => "Livraison",
            _ => type
        };
    }
}
