@model LoginViewModel
@{
    ViewData["Title"] = "Connexion";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-form-side">
        <div class="auth-form-wrapper">
            <div class="text-center mb-4">
                <a href="/" class="auth-logo">
                    <i class="fas fa-hamburger"></i>
                    <span class="text-white">Brasil</span> <span class="text-orange">Burger</span>
                </a>
            </div>
            
            <h2 class="auth-title">Connexion</h2>
            <p class="auth-subtitle">Connectez-vous pour commander</p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="votre@email.com">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Mot de passe</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="********">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-orange w-100 mb-3">Se connecter</button>

                <p class="text-center text-muted">
                    Pas encore de compte? <a asp-action="Register" class="text-orange">S'inscrire</a>
                </p>
            </form>
        </div>
    </div>
    <div class="auth-image-side">
        <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?w=800" alt="Burger">
        <div class="auth-image-overlay">
            <h3>Des burgers <span class="text-orange">exceptionnels</span></h3>
        </div>
    </div>
</div>
