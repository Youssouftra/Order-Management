@model List<CartItem>
@{
    ViewData["Title"] = "Mon Panier";
    var total = Model.Sum(c => c.Prix * c.Quantite);
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <a href="/" class="btn btn-link text-orange mb-3">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-5x text-muted mb-4"></i>
            <h3>Votre panier est vide</h3>
            <p class="text-muted">Ajoutez des articles pour commencer</p>
            <a href="/" class="btn btn-orange">Voir la carte</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="cart-items">
                    @foreach (var item in Model)
                    {
                        <div class="cart-item">
                            <div class="cart-item-image">
                                @if (!string.IsNullOrEmpty(item.Image))
                                {
                                    <img src="@item.Image" alt="@item.Nom">
                                }
                                else
                                {
                                    <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=100" alt="@item.Nom">
                                }
                            </div>
                            <div class="cart-item-details">
                                <h5>@item.Nom</h5>
                                <span class="badge bg-secondary">@item.Type</span>
                            </div>
                            <div class="cart-item-price">
                                @item.Prix.ToString("N0") FCFA
                            </div>
                            <div class="cart-item-quantity">
                                <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-2">
                                    <input type="hidden" name="id" value="@item.Id">
                                    <input type="hidden" name="type" value="@item.Type">
                                    <button type="submit" name="quantite" value="@(item.Quantite - 1)" class="btn btn-sm btn-outline-orange">-</button>
                                    <span class="quantity-display">@item.Quantite</span>
                                    <button type="submit" name="quantite" value="@(item.Quantite + 1)" class="btn btn-sm btn-outline-orange">+</button>
                                </form>
                            </div>
                            <div class="cart-item-total">
                                @((item.Prix * item.Quantite).ToString("N0")) FCFA
                            </div>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="id" value="@item.Id">
                                <input type="hidden" name="type" value="@item.Type">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="cart-summary">
                    <h4>Recapitulatif</h4>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Sous-total</span>
                        <span>@total.ToString("N0") FCFA</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total</strong>
                        <strong class="text-orange">@total.ToString("N0") FCFA</strong>
                    </div>
                    <a asp-controller="Orders" asp-action="Checkout" class="btn btn-orange w-100">
                        Passer la commande
                    </a>
                </div>
            </div>
        </div>
    }
</div>
