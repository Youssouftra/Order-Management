@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="container py-5">
    <div class="text-center">
        <h1 class="display-4 text-danger">Oops!</h1>
        <p class="lead">Une erreur s'est produite.</p>
        @if (Model?.ShowRequestId ?? false)
        {
            <p class="text-muted">Request ID: @Model.RequestId</p>
        }
        <a href="/" class="btn btn-orange mt-3">Retour a l'accueil</a>
    </div>
</div>
