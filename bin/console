#!/usr/bin/env php
<?php

use App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\ErrorHandler\Debug;

if (!is_file(dirname(__DIR__).'/vendor/autoload.php')) {
    throw new LogicException('Les dépendances ne sont pas installées. Exécutez "composer install" d\'abord.');
}

require dirname(__DIR__).'/vendor/autoload.php';

$input = new ArgvInput();
$_SERVER['APP_ENV'] = $input->getParameterOption(['--env', '-e'], $_SERVER['APP_ENV'] ?? 'dev', true);
$_SERVER['APP_DEBUG'] = ($_SERVER['APP_DEBUG'] ?? ('prod' !== $_SERVER['APP_ENV'])) && !$input->hasParameterOption('--no-debug', true);

if ($_SERVER['APP_DEBUG']) {
    umask(0000);
    if (class_exists(Debug::class)) {
        Debug::enable();
    }
}

$kernel = new Kernel($_SERVER['APP_ENV'], (bool) $_SERVER['APP_DEBUG']);
$application = new Application($kernel);
$application->run($input);
