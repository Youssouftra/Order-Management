<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Brasil Burger{% endblock %} | Gestionnaire</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="{{ asset('css/style.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <div class="logo-container">
                    <div class="logo-icon">🍔</div>
                    <span class="logo-text">Brasil<span class="text-warning">Burger</span></span>
                </div>
            </div>

            <ul class="sidebar-nav">
                <li class="nav-item">
                    <a href="{{ path('app_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a href="{{ path('app_burger_index') }}" class="nav-link {% if 'burger' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i>
                        <span>Burgers</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a href="{{ path('app_menu_index') }}" class="nav-link {% if 'menu' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-basket3-fill"></i>
                        <span>Menus</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a href="{{ path('app_complement_index') }}" class="nav-link {% if 'complement' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-cup-straw"></i>
                        <span>Complément</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a href="{{ path('app_commande_index') }}" class="nav-link {% if 'commande' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-receipt"></i>
                        <span>Commandes</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a href="{{ path('app_zone_index') }}" class="nav-link {% if 'zone' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>Zones</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a href="{{ path('app_livreur_index') }}" class="nav-link {% if 'livreur' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-bicycle"></i>
                        <span>Livreurs</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a href="{{ path('app_settings') }}" class="nav-link {% if 'settings' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-gear-fill"></i>
                        <span>Paramètres</span>
                    </a>
                </li>
                
                <li class="nav-item" style="margin-top: auto;">
                    <a href="{{ path('app_logout') }}" class="nav-link">
                        <i class="bi bi-box-arrow-left"></i>
                        <span>Déconnexion</span>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <div id="content">
            <!-- Top Navbar -->
            <nav class="topbar">
                <button id="sidebarToggle" class="btn btn-link d-md-none topbar-icon">
                    <i class="bi bi-list"></i>
                </button>
                
                <div class="page-info d-none d-md-block">
                    {% block page_header %}
                    <h1>{% block page_title %}Dashboard{% endblock %}</h1>
                    <p class="subtitle">{% block page_subtitle %}{% endblock %}</p>
                    {% endblock %}
                </div>
                
                <div class="search-box d-none d-lg-block">
                    <i class="bi bi-search"></i>
                    <input type="text" class="form-control" placeholder="Rechercher...">
                </div>
                
                <div class="topbar-right">
                    <button class="topbar-icon">
                        <i class="bi bi-moon-fill"></i>
                    </button>
                    <button class="topbar-icon position-relative">
                        <i class="bi bi-bell-fill"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                            3
                        </span>
                    </button>
                    <div class="dropdown">
                        <a class="user-dropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-info d-none d-md-block">
                                <div class="name">{{ app.user ? app.user.prenom ~ ' ' ~ app.user.nom : 'Admin' }}</div>
                                <div class="role">Gestionnaire</div>
                            </div>
                            <div class="user-avatar">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Mon profil</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Paramètres</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Page Content -->
            <div class="container-fluid">
                {% include 'components/flash_messages.html.twig' %}
                {% block body %}{% endblock %}
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('active');
        });

        // Expand/collapse order cards
        document.querySelectorAll('.order-card .order-header').forEach(header => {
            header.addEventListener('click', function() {
                this.closest('.order-card').classList.toggle('expanded');
            });
        });
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
