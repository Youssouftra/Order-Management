{% extends 'base.html.twig' %}

{% block title %}{{ livreur.id ? 'Modifier' : 'Nouveau' }} livreur - Brasil Burger{% endblock %}

{% block body %}
<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <a href="{{ path('app_livreur_index') }}" class="btn btn-back">← Retour</a>
            <h1>{{ livreur.id ? 'Modifier' : 'Nouveau' }} livreur</h1>
        </div>
    </div>

    {% include 'components/flash_messages.html.twig' %}

    <div class="form-container">
        {{ form_start(form, {'attr': {'class': 'main-form', 'enctype': 'multipart/form-data'}}) }}
        
        <div class="form-grid">
            <div class="form-main">
                <div class="form-card">
                    <h3>Informations personnelles</h3>
                    
                    <div class="form-row">
                        <div class="form-group">
                            {{ form_label(form.prenom) }}
                            {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
                            {{ form_errors(form.prenom) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}}) }}
                            {{ form_errors(form.nom) }}
                        </div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.telephone) }}
                        {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': '+221 XX XXX XX XX'}}) }}
                        {{ form_errors(form.telephone) }}
                    </div>
                </div>

                <div class="form-card">
                    <h3>Affectation</h3>
                    
                    <div class="form-group">
                        {{ form_label(form.zone) }}
                        {{ form_widget(form.zone, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.zone) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.statut) }}
                        {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.statut) }}
                    </div>
                </div>
            </div>

            <div class="form-sidebar">
                <div class="form-card">
                    <h3>Photo</h3>
                    
                    {% if livreur.photo %}
                        <div class="current-image">
                            <img src="{{ livreur.photo }}" alt="{{ livreur.prenom }}">
                            <p class="image-hint">Photo actuelle</p>
                        </div>
                    {% endif %}
                    
                    <div class="form-group">
                        {{ form_label(form.photoFile) }}
                        {{ form_widget(form.photoFile, {'attr': {'class': 'form-control-file', 'accept': 'image/*'}}) }}
                        {{ form_errors(form.photoFile) }}
                        <p class="form-hint">Formats acceptés: JPG, PNG, GIF (max 2 Mo)</p>
                    </div>
                </div>

                <div class="form-card">
                    <h3>Statut du compte</h3>
                    
                    <div class="form-group">
                        <label class="switch-label">
                            {{ form_widget(form.isActive, {'attr': {'class': 'switch-input'}}) }}
                            <span class="switch-text">Livreur actif</span>
                        </label>
                        {{ form_errors(form.isActive) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a href="{{ path('app_livreur_index') }}" class="btn btn-outline">Annuler</a>
            <button type="submit" class="btn btn-primary">
                {{ livreur.id ? 'Enregistrer les modifications' : 'Créer le livreur' }}
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
