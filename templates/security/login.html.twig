<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion | Brasil Burger</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="{{ asset('css/style.css') }}" rel="stylesheet">
</head>
<body>
    <div class="login-page">
        <!-- Hero Section -->
        <div class="login-hero" style="background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=800') center/cover;">
            <div class="login-hero-content">
                <div class="logo">
                    <div class="logo-icon">🍔</div>
                    <div>
                        <h1>Brasil <span>Burger</span></h1>
                        <p>Dashboard & Gestion</p>
                    </div>
                </div>
                <p class="description">
                    Gérez vos commandes, produits et livraisons en toute simplicité. 
                    Interface moderne pour une gestion efficace de votre restaurant.
                </p>
            </div>
        </div>

        <!-- Login Form Section -->
        <div class="login-form-container">
            <div class="login-form-wrapper">
                <h2>Bonjour Gestionnaire</h2>
                <p class="subtitle">Bienvenue sur Brasil Burger Dashboard</p>

                {% if error %}
                    <div class="alert alert-danger">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form class="login-form" method="post">
                    <div class="form-group">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" id="email" name="_username" class="form-control" 
                               placeholder="admin@brasilburger.com" value="{{ last_username }}" required autofocus>
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" id="password" name="_password" class="form-control" 
                               placeholder="••••••••" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="forgot-password">
                        <a href="#">Mot de passe oublié ?</a>
                    </div>

                    <button type="submit" class="btn btn-login">Login</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
