{% extends 'base.html.twig' %}

{% block title %}Burgers{% endblock %}

{% block page_title %}Burgers{% endblock %}
{% block page_subtitle %}{{ pagination.totalItems|default(0) }} burger(s) actif(s){% endblock %}

{% block body %}
<div class="burgers-page">
    <!-- Toolbar -->
    <div class="toolbar">
        <div class="toolbar-left">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <form method="get" action="{{ path('app_burger_index') }}" style="width: 100%;">
                    <input type="text" name="search" class="form-control" placeholder="Rechercher un burger..." value="{{ app.request.query.get('search') }}">
                </form>
            </div>
        </div>
        <div class="toolbar-right">
            <a href="{{ path('app_burger_index', {status: app.request.query.get('status') == '0' ? '' : '0'}) }}" 
               class="btn btn-outline {% if app.request.query.get('status') == '0' %}active{% endif %}">
                <i class="bi bi-archive"></i> Voir archivés
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#burgerModal">
                <i class="bi bi-plus-lg"></i> Ajouter
            </button>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="product-grid">
        {% for burger in burgers %}
            <div class="product-card">
                {% if burger.image %}
                    <img src="{{ burger.image }}" alt="{{ burger.nom }}" class="product-image">
                {% else %}
                    <div class="product-image-placeholder">
                        <i class="bi bi-image"></i>
                    </div>
                {% endif %}
                <div class="product-body">
                    <div class="product-header">
                        <h3 class="product-name">{{ burger.nom }}</h3>
                        <span class="product-price">{{ burger.prix|number_format(0, ',', ' ') }} F</span>
                    </div>
                    <p class="product-description">{{ burger.description|default('Aucune description')|slice(0, 80) }}{% if burger.description|length > 80 %}...{% endif %}</p>
                </div>
                <div class="product-footer">
                    <button type="button" class="btn btn-icon btn-outline" onclick="editBurger({{ burger.id }})" title="Modifier">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <form action="{{ path('app_burger_toggle', {id: burger.id}) }}" method="post" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ burger.id) }}">
                        <button type="submit" class="btn btn-icon btn-outline" title="{{ burger.isActive ? 'Désactiver' : 'Activer' }}">
                            <i class="bi bi-{{ burger.isActive ? 'eye-slash' : 'eye' }}"></i>
                        </button>
                    </form>
                </div>
            </div>
        {% else %}
            <div class="empty-state" style="grid-column: 1 / -1;">
                <i class="bi bi-egg-fried"></i>
                <h4>Aucun burger trouvé</h4>
                <p>Commencez par ajouter votre premier burger</p>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#burgerModal">
                    <i class="bi bi-plus-lg"></i> Ajouter un burger
                </button>
            </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% if pagination.totalPages|default(1) > 1 %}
        <nav>
            <ul class="pagination">
                <li class="page-item {% if pagination.currentPage == 1 %}disabled{% endif %}">
                    <a class="page-link" href="{{ path('app_burger_index', {page: pagination.currentPage - 1, search: app.request.query.get('search')}) }}">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                {% for i in 1..pagination.totalPages %}
                    <li class="page-item {% if pagination.currentPage == i %}active{% endif %}">
                        <a class="page-link" href="{{ path('app_burger_index', {page: i, search: app.request.query.get('search')}) }}">{{ i }}</a>
                    </li>
                {% endfor %}
                <li class="page-item {% if pagination.currentPage == pagination.totalPages %}disabled{% endif %}">
                    <a class="page-link" href="{{ path('app_burger_index', {page: pagination.currentPage + 1, search: app.request.query.get('search')}) }}">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    {% endif %}
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="burgerModal" tabindex="-1" aria-labelledby="burgerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="burgerModalLabel">Ajouter un burger</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="burgerForm" action="{{ path('app_burger_new') }}" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="burger_nom" class="form-label">Nom</label>
                        <input type="text" class="form-control" id="burger_nom" name="burger[nom]" placeholder="Nom du produit" required>
                    </div>
                    <div class="mb-3">
                        <label for="burger_description" class="form-label">Description</label>
                        <textarea class="form-control" id="burger_description" name="burger[description]" rows="3" placeholder="Description du produit"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="burger_prix" class="form-label">Prix (FCFA)</label>
                        <input type="number" class="form-control" id="burger_prix" name="burger[prix]" placeholder="0" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label for="burger_image" class="form-label">URL de l'image</label>
                        <input type="url" class="form-control" id="burger_image" name="burger[image]" placeholder="https://...">
                    </div>
                    <input type="hidden" name="burger[_token]" value="{{ csrf_token('burger') }}">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Ajouter</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
function editBurger(id) {
    window.location.href = '/burgers/' + id + '/edit';
}
</script>
{% endblock %}
