{% extends 'base.html.twig' %}

{% block title %}{{ burger.id ? 'Modifier' : 'Ajouter' }} un burger{% endblock %}

{% block page_title %}{{ burger.id ? 'Modifier' : 'Ajouter' }} un burger{% endblock %}

{% block body %}
<div class="form-page">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="dashboard-card">
                <div class="card-header">
                    <h3>{{ burger.id ? 'Modifier le burger' : 'Nouveau burger' }}</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                        
                        <div class="mb-3">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom du produit'}}) }}
                            {{ form_errors(form.nom) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'placeholder': 'Description du produit', 'rows': 4}}) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.prix) }}
                            {{ form_widget(form.prix, {'attr': {'class': 'form-control', 'placeholder': '0'}}) }}
                            {{ form_errors(form.prix) }}
                        </div>

                        {% if burger.image %}
                            <div class="mb-3">
                                <label class="form-label">Image actuelle</label>
                                <div>
                                    <img src="{{ burger.image }}" alt="{{ burger.nom }}" style="max-width: 200px; border-radius: 10px;">
                                </div>
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            {{ form_label(form.imageFile) }}
                            {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.imageFile) }}
                            <div class="form-text">Formats acceptés: JPG, PNG, GIF (max 5MB)</div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <a href="{{ path('app_burger_index') }}" class="btn btn-outline">Annuler</a>
                            <button type="submit" class="btn btn-primary">
                                {{ burger.id ? 'Enregistrer' : 'Ajouter' }}
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
