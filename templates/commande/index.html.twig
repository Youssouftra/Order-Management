{% extends 'base.html.twig' %}

{% block title %}Commandes{% endblock %}
{% block page_title %}Commandes{% endblock %}
{% block page_subtitle %}{{ commandes|length }} commande(s){% endblock %}

{% block body %}
<div class="commandes-page">
    <!-- View Tabs -->
    <div class="filter-tabs-container">
        <div class="filter-tabs">
            <a href="{{ path('app_commande_index') }}" class="filter-tab {% if not app.request.query.get('view') or app.request.query.get('view') == 'all' %}active{% endif %}">
                Toutes les commandes
            </a>
            <a href="{{ path('app_commande_index', {view: 'zones'}) }}" class="filter-tab {% if app.request.query.get('view') == 'zones' %}active{% endif %}">
                Livraisons par zone
            </a>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="dashboard-card">
        <div class="card-header">
            <h3><i class="bi bi-funnel"></i> Filtres</h3>
        </div>
        <div class="card-body">
            <form method="get" class="filters-form">
                {% if app.request.query.get('view') %}
                <input type="hidden" name="view" value="{{ app.request.query.get('view') }}">
                {% endif %}
                <div class="filters-row">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" name="search" class="form-control" value="{{ app.request.query.get('search') }}" placeholder="Rechercher...">
                    </div>
                    <select name="etat" class="form-select">
                        <option value="">Tous les états</option>
                        <option value="en_attente" {{ app.request.query.get('etat') == 'en_attente' ? 'selected' : '' }}>En attente</option>
                        <option value="confirmee" {{ app.request.query.get('etat') == 'confirmee' ? 'selected' : '' }}>Confirmée</option>
                        <option value="en_preparation" {{ app.request.query.get('etat') == 'en_preparation' ? 'selected' : '' }}>En préparation</option>
                        <option value="prete" {{ app.request.query.get('etat') == 'prete' ? 'selected' : '' }}>Prête</option>
                        <option value="en_livraison" {{ app.request.query.get('etat') == 'en_livraison' ? 'selected' : '' }}>En livraison</option>
                        <option value="livree" {{ app.request.query.get('etat') == 'livree' ? 'selected' : '' }}>Livrée</option>
                        <option value="annulee" {{ app.request.query.get('etat') == 'annulee' ? 'selected' : '' }}>Annulée</option>
                    </select>
                    <select name="mode" class="form-select">
                        <option value="">Tous les modes</option>
                        <option value="livraison" {{ app.request.query.get('mode') == 'livraison' ? 'selected' : '' }}>Livraison</option>
                        <option value="sur_place" {{ app.request.query.get('mode') == 'sur_place' ? 'selected' : '' }}>Sur place</option>
                        <option value="a_emporter" {{ app.request.query.get('mode') == 'a_emporter' ? 'selected' : '' }}>À emporter</option>
                    </select>
                    <div class="date-input">
                        <i class="bi bi-calendar3"></i>
                        <input type="date" name="date" class="form-control" value="{{ app.request.query.get('date') }}">
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Filtrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Orders List -->
    {% if app.request.query.get('view') == 'zones' %}
        <!-- Grouped by Zone View -->
        {% set ordersByZone = {} %}
        {% for commande in commandes %}
            {% set zoneName = commande.zone ? commande.zone.nom : 'Sans zone' %}
            {% if ordersByZone[zoneName] is not defined %}
                {% set ordersByZone = ordersByZone|merge({(zoneName): []}) %}
            {% endif %}
            {% set ordersByZone = ordersByZone|merge({(zoneName): ordersByZone[zoneName]|merge([commande])}) %}
        {% endfor %}

        {% for zoneName, zoneCommandes in ordersByZone %}
        <div class="zone-group">
            <div class="zone-group-header">
                <h3>{{ zoneName }}</h3>
                <span class="badge badge-count">{{ zoneCommandes|length }} commande(s)</span>
            </div>
            <div class="orders-list">
                {% for commande in zoneCommandes %}
                    {{ _self.order_card(commande) }}
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    {% else %}
        <!-- All Orders View -->
        <div class="orders-list">
            {% for commande in commandes %}
                {{ _self.order_card(commande) }}
            {% else %}
                <div class="empty-state">
                    <i class="bi bi-receipt"></i>
                    <h3>Aucune commande</h3>
                    <p>Les commandes apparaîtront ici</p>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% macro order_card(commande) %}
<div class="order-card" data-order-id="{{ commande.id }}">
    <div class="order-header" onclick="toggleOrder(this)">
        <div class="order-left">
            <div class="order-number">
                <strong>BB-{{ commande.createdAt|date('Y') }}-{{ '%04d'|format(commande.id) }}</strong>
                <span class="badge badge-status-{{ commande.etat }}">{{ commande.etat|replace({'_': ' '})|capitalize }}</span>
                <span class="badge badge-mode-{{ commande.modeLivraison ?? 'livraison' }}">
                    {% if commande.modeLivraison == 'sur_place' %}Sur place
                    {% elseif commande.modeLivraison == 'a_emporter' %}À emporter
                    {% else %}Livraison{% endif %}
                </span>
            </div>
            <div class="order-client">
                <i class="bi bi-person"></i>
                <span>{{ commande.clientNom }}</span>
            </div>
            <div class="order-meta">
                <span class="meta-item">
                    <i class="bi bi-telephone"></i>
                    {{ commande.clientTelephone }}
                </span>
                {% if commande.zone %}
                <span class="meta-item">
                    <i class="bi bi-geo-alt"></i>
                    {{ commande.zone.nom }}
                </span>
                {% endif %}
                <span class="meta-item">
                    <i class="bi bi-clock"></i>
                    {{ commande.createdAt|date('H:i') }}
                </span>
            </div>
        </div>
        <div class="order-right">
            <div class="order-total">{{ commande.montantTotal|number_format(0, ' ', ' ') }} F</div>
            <div class="order-items-count">
                <i class="bi bi-basket3"></i>
                {{ commande.ligneCommandes|length }} article(s)
            </div>
            <i class="bi bi-chevron-down expand-icon"></i>
        </div>
    </div>
    <div class="order-details">
        <div class="order-details-header">Détails de la commande</div>
        <div class="order-items-list">
            {% for ligne in commande.ligneCommandes %}
            <div class="order-item">
                <div class="item-image">
                    {% if ligne.burger and ligne.burger.image %}
                        <img src="{{ ligne.burger.image }}" alt="">
                    {% elseif ligne.menu and ligne.menu.image %}
                        <img src="{{ ligne.menu.image }}" alt="">
                    {% else %}
                        <div class="item-placeholder"><i class="bi bi-circle-fill"></i></div>
                    {% endif %}
                </div>
                <div class="item-info">
                    <div class="item-name">
                        {% if ligne.burger %}{{ ligne.burger.nom }}
                        {% elseif ligne.menu %}{{ ligne.menu.nom }}
                        {% elseif ligne.complement %}{{ ligne.complement.nom }}
                        {% endif %}
                    </div>
                    <div class="item-quantity">{{ ligne.quantite }} x {{ ligne.prixUnitaire|number_format(0, ' ', ' ') }} F</div>
                    {% if ligne.complements|length > 0 %}
                    <div class="item-extras">
                        + {% for comp in ligne.complements %}{{ comp.nom }}{% if not loop.last %}, {% endif %}{% endfor %}
                    </div>
                    {% endif %}
                </div>
                <div class="item-total">{{ (ligne.quantite * ligne.prixUnitaire)|number_format(0, ' ', ' ') }} F</div>
            </div>
            {% endfor %}
        </div>
        <div class="order-summary">
            <div class="summary-row">
                <span>Sous-total</span>
                <span>{{ (commande.montantTotal - (commande.fraisLivraison ?? 0))|number_format(0, ' ', ' ') }} F</span>
            </div>
            <div class="summary-row">
                <span>Frais de livraison</span>
                <span>{{ (commande.fraisLivraison ?? 0)|number_format(0, ' ', ' ') }} F</span>
            </div>
            <div class="summary-row total">
                <span>Total</span>
                <span>{{ commande.montantTotal|number_format(0, ' ', ' ') }} F</span>
            </div>
        </div>
        <div class="order-actions">
            {% if commande.etat == 'en_attente' or commande.etat == 'confirmee' %}
            <form action="{{ path('app_commande_change_etat', {id: commande.id}) }}" method="post" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('etat' ~ commande.id) }}">
                <input type="hidden" name="etat" value="en_preparation">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat"></i> Passer à "En préparation"
                </button>
            </form>
            {% elseif commande.etat == 'en_preparation' %}
            <form action="{{ path('app_commande_change_etat', {id: commande.id}) }}" method="post" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('etat' ~ commande.id) }}">
                <input type="hidden" name="etat" value="prete">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat"></i> Passer à "Prête"
                </button>
            </form>
            {% elseif commande.etat == 'prete' %}
            <form action="{{ path('app_commande_change_etat', {id: commande.id}) }}" method="post" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('etat' ~ commande.id) }}">
                <input type="hidden" name="etat" value="en_livraison">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat"></i> Passer à "En livraison"
                </button>
            </form>
            {% elseif commande.etat == 'en_livraison' %}
            <form action="{{ path('app_commande_change_etat', {id: commande.id}) }}" method="post" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('etat' ~ commande.id) }}">
                <input type="hidden" name="etat" value="livree">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Marquer livrée
                </button>
            </form>
            {% endif %}
            
            {% if commande.etat not in ['livree', 'annulee'] %}
            <form action="{{ path('app_commande_change_etat', {id: commande.id}) }}" method="post" class="d-inline" 
                  onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette commande ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('etat' ~ commande.id) }}">
                <input type="hidden" name="etat" value="annulee">
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle"></i> Annuler
                </button>
            </form>
            {% endif %}
        </div>
    </div>
</div>
{% endmacro %}
{% endblock %}

{% block javascripts %}
<script>
function toggleOrder(header) {
    const card = header.closest('.order-card');
    card.classList.toggle('expanded');
}
</script>
{% endblock %}
